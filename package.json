{
  "name": "tucker-tally",
  "version": "1.0.0",
  "description": "Self-hosted calorie and macro tracker. Runs on your laptop, used from your phone.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/check-node.js && npm install --include=dev --no-audit --no-fund && npm run build && npm run migrate",
    "start": "node scripts/check-node.js && node server/index.js",
    "build": "vite build",
    "migrate": "node scripts/migrate.js",
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "backup": "node scripts/backup-now.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
